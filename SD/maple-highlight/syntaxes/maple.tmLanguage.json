{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Maple",
  "scopeName": "source.maple",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#backtick-name" },
    { "include": "#number" },
    { "include": "#keyword-control" },
    { "include": "#keyword-proc" },
    { "include": "#keyword-logical" },
    { "include": "#constant-language" },
    { "include": "#function-call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.maple",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.maple",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.maple", "match": "\\\\." }
      ]
    },
    "backtick-name": {
      "name": "string.quoted.backtick.maple",
      "begin": "`",
      "end": "`"
    },
    "number": {
      "name": "constant.numeric.maple",
      "match": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b"
    },
    "keyword-control": {
      "name": "keyword.control.maple",
      "match": "\\b(if|then|else|elif|fi|for|from|to|by|in|while|do|od|end|break|next|try|catch|finally|return|use)\\b"
    },
    "keyword-proc": {
      "name": "keyword.other.maple",
      "match": "\\b(proc|local|global|option|description|module|export|read|save|quit|done|error)\\b"
    },
    "keyword-logical": {
      "name": "keyword.operator.word.maple",
      "match": "\\b(and|or|not|xor|implies|mod|intersect|union|minus|subset)\\b"
    },
    "constant-language": {
      "name": "constant.language.maple",
      "match": "\\b(true|false|FAIL|NULL|undefined|infinity|Pi|E|I|gamma|Catalan)\\b"
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.maple" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.maple",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.maple",
          "match": ":="
        },
        {
          "name": "keyword.operator.type.maple",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.maple",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.maple",
          "match": "[+\\-*/^=<>!&|@~$%]"
        }
      ]
    }
  }
}
