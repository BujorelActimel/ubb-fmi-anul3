#!/bin/bash
# Usage: minigo [run|build|clean] file.go

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPILER="${SCRIPT_DIR}/build/minigo"
OUTPUT_DIR="${SCRIPT_DIR}/output"
BUILD_DIR="${SCRIPT_DIR}/build"

ensure_compiler_built() {
    if [ ! -f "$COMPILER" ]; then
        echo -e "${YELLOW}Compiler not found. Building...${NC}"
        cd "$SCRIPT_DIR"
        make > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            echo -e "${RED}Error: Failed to build compiler${NC}"
            echo "Run 'make' to see detailed error messages"
            exit 1
        fi
        echo -e "${GREEN}Compiler built successfully${NC}"
    fi
}

usage() {
    cat << EOF
MiniGo Compiler - A Go subset compiler

Usage:
    minigo run file.go        Compile and run immediately
    minigo build file.go      Compile to executable
    minigo asm file.go        Generate assembly only
    minigo clean              Clean generated files
    minigo help               Show this help

Examples:
    minigo run tests/test1.go
    minigo build tests/test1.go -o myprogram
    minigo asm tests/test1.go

Generated files:
    Assembly:   ${OUTPUT_DIR}/*.s
    Objects:    ${OUTPUT_DIR}/*.o
    Binaries:   ${OUTPUT_DIR}/*

EOF
}

cmd_run() {
    local go_file="$1"

    if [ -z "$go_file" ]; then
        echo -e "${RED}Error: No input file specified${NC}"
        echo "Usage: minigo run file.go"
        exit 1
    fi

    if [ ! -f "$go_file" ]; then
        echo -e "${RED}Error: File '$go_file' not found${NC}"
        exit 1
    fi

    ensure_compiler_built
    mkdir -p "$OUTPUT_DIR"

    local basename=$(basename "$go_file" .go)
    local asm_file="${OUTPUT_DIR}/${basename}.s"
    local binary="${OUTPUT_DIR}/${basename}"

    echo -e "${BLUE}Compiling${NC} $go_file..."
    "$COMPILER" "$go_file" -o "$asm_file" 2>&1 | grep -v "Parsing\|Generating\|Assembly written" || true

    if [ ${PIPESTATUS[0]} -ne 0 ]; then
        echo -e "${RED}Compilation failed${NC}"
        exit 1
    fi

    echo -e "${BLUE}Assembling${NC} ${basename}.s..."
    gcc -o "$binary" "$asm_file" 2>&1

    if [ $? -ne 0 ]; then
        echo -e "${RED}Assembly failed${NC}"
        exit 1
    fi

    echo -e "${GREEN}Build successful${NC}"
    echo -e "${BLUE}Running${NC} $basename...\n"
    echo "----------------------------------------"

    "$binary"
    local exit_code=$?

    echo "----------------------------------------"
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}Program exited with code 0${NC}"
    else
        echo -e "${RED}Program exited with code $exit_code${NC}"
    fi
}

cmd_build() {
    local go_file="$1"
    local output_name=""

    # Parse arguments
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -o)
                output_name="$2"
                shift 2
                ;;
            *)
                echo -e "${RED}Error: Unknown option '$1'${NC}"
                exit 1
                ;;
        esac
    done

    if [ -z "$go_file" ]; then
        echo -e "${RED}Error: No input file specified${NC}"
        echo "Usage: minigo build file.go [-o output]"
        exit 1
    fi

    if [ ! -f "$go_file" ]; then
        echo -e "${RED}Error: File '$go_file' not found${NC}"
        exit 1
    fi

    ensure_compiler_built
    mkdir -p "$OUTPUT_DIR"

    local basename=$(basename "$go_file" .go)
    local asm_file="${OUTPUT_DIR}/${basename}.s"

    if [ -z "$output_name" ]; then
        output_name="${OUTPUT_DIR}/${basename}"
    fi

    echo -e "${BLUE}Compiling${NC} $go_file..."
    "$COMPILER" "$go_file" -o "$asm_file" 2>&1 | grep -v "Parsing\|Generating\|Assembly written" || true

    if [ ${PIPESTATUS[0]} -ne 0 ]; then
        echo -e "${RED}Compilation failed${NC}"
        exit 1
    fi

    echo -e "${BLUE}Linking${NC} $output_name..."
    gcc -o "$output_name" "$asm_file" 2>&1

    if [ $? -ne 0 ]; then
        echo -e "${RED}Linking failed${NC}"
        exit 1
    fi

    echo -e "${GREEN}Build successful${NC}"
    echo -e "Executable: ${BLUE}$output_name${NC}"
    echo -e "Run with: ${GREEN}$output_name${NC}"
}

cmd_asm() {
    local go_file="$1"

    if [ -z "$go_file" ]; then
        echo -e "${RED}Error: No input file specified${NC}"
        echo "Usage: minigo asm file.go"
        exit 1
    fi

    if [ ! -f "$go_file" ]; then
        echo -e "${RED}Error: File '$go_file' not found${NC}"
        exit 1
    fi

    ensure_compiler_built
    mkdir -p "$OUTPUT_DIR"

    local basename=$(basename "$go_file" .go)
    local asm_file="${OUTPUT_DIR}/${basename}.s"

    echo -e "${BLUE}Generating assembly${NC} for $go_file..."
    "$COMPILER" "$go_file" -o "$asm_file"

    if [ $? -ne 0 ]; then
        echo -e "${RED}Code generation failed${NC}"
        exit 1
    fi

    echo -e "${GREEN}Assembly generated${NC}: ${BLUE}$asm_file${NC}"
    echo -e "\nTo view: ${GREEN}cat $asm_file${NC}"
    echo -e "To build: ${GREEN}gcc -o ${basename} $asm_file${NC}"
}

cmd_clean() {
    echo -e "${BLUE}Cleaning generated files...${NC}"

    rm -rf "$OUTPUT_DIR"/*.s "$OUTPUT_DIR"/*.o "$OUTPUT_DIR"/*.out

    find "$OUTPUT_DIR" -type f ! -name "*.*" -delete 2>/dev/null || true

    echo -e "${GREEN}Clean complete${NC}"
}

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        run)
            cmd_run "$@"
            ;;
        build)
            cmd_build "$@"
            ;;
        asm)
            cmd_asm "$@"
            ;;
        clean)
            cmd_clean
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            echo -e "${RED}Error: Unknown command '$command'${NC}"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
